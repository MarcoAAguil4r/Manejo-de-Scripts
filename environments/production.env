# Parámetros del entorno de producción. Sin secretos en este archivo.
# GRAFANA_ADMIN_PASSWORD se inyecta desde el pipeline (secreto del Environment "production").
ENV_NAME=production
APP_PORT=8080
PROM_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=info
APP_MEM_LIMIT=512m
APP_CPUS=1.0
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=35d
# Verificación posterior al despliegue
LOAD_DURATION=10
LOAD_CONCURRENCY=5
SLO_MIN_AVAILABILITY=99.5
SLO_MAX_P95_MS=300
SLO_WINDOW=30d
