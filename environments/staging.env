# Parámetros del entorno de liberación (staging). Sin secretos en este archivo.
ENV_NAME=staging
APP_PORT=8081
PROM_PORT=9091
GRAFANA_PORT=3001
LOG_LEVEL=debug
APP_MEM_LIMIT=256m
APP_CPUS=0.5
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=7d
# Umbrales de las pruebas en este entorno (ver scripts/tests/run-all.sh)
LOAD_DURATION=20
LOAD_CONCURRENCY=20
SLO_MIN_AVAILABILITY=99.5
SLO_MAX_P95_MS=300
